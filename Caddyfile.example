# 把下面的域名改成你自己的，Caddy 会自动申请并续期 HTTPS 证书。
pay.example.com {
	# 反向代理到 Compose 网络内的网关容器
	reverse_proxy epay:8080

	# 管理后台限制来源 IP（可选）：取消注释并改成你的办公网 / 家庭宽带 IP
	# @admin path /admin*
	# handle @admin {
	# 	@blocked not remote_ip 1.2.3.4
	# 	respond @blocked 403
	# 	reverse_proxy epay:8080
	# }

	encode zstd gzip
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
